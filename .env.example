# GAP AI Environment Configuration

PORT=5000
JWT_SECRET=super_secure_gap_ai_jwt_secret_change_in_production_2026

# Database Configuration (Optional Neon / PostgreSQL connection string)
# Leave empty to use zero-config embedded persistent JSON/File database
